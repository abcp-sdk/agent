{
  "name": "abcp-agent",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=@abcp-agent/schema && npm run build --workspace=@abcp-agent/agent && npm run build --workspace=@abcp-agent/server && node scripts/build-sea.mjs",
    "check": "biome check .",
    "check:fix": "biome check --fix .",
    "dev": "tsx watch packages/server/src/index.ts",
    "dev:server": "tsx watch packages/server/src/index.ts",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "start": "node .sea/abcp-agent",
    "test": "npm test --workspaces --if-present",
    "e2e": "tsx scripts/e2e.mts",
    "e2e:build": "npm run build && tsx scripts/e2e.mts",
    "e2e:providers": "tsx scripts/provider-e2e.mts",
    "typecheck": "tsc -p packages/agent/tsconfig.json --noEmit && tsc -p packages/server/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@abc-protocol/sdk": "github:abcp-sdk/abc-protocol-typescript#v3.5.0",
    "@biomejs/biome": "^2.5.9",
    "@types/node": "^26.2.0",
    "postject": "^1.0.0-alpha.6",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@lucide/svelte": "^1.33.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@abcp/client-sdk@0.1.1": true,
    "@abcp/agent-sdk@0.18.0": true
  },
  "overrides": {
    "@ai-sdk/gateway": "4.0.78",
    "@ai-sdk/cohere": "3.0.61"
  }
}
