{
  "name": "zergx-agent",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=@zergx-agent/schema && npm run build --workspace=@zergx-agent/agent && npm run build --workspace=@zergx-agent/server && npm run build --workspace=@zergx-agent/ui && node scripts/build-sea.mjs",
    "check": "biome check .",
    "check:fix": "biome check --fix .",
    "dev": "tsx watch packages/server/src/index.ts",
    "dev:server": "tsx watch packages/server/src/index.ts",
    "dev:web": "npm run dev --workspace=@zergx-agent/ui",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "start": "node .sea/zergx-agent",
    "test": "npm test --workspaces --if-present"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@types/node": "^26.2.0",
    "postject": "^1.0.0-alpha.6",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@lucide/svelte": "^1.33.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
