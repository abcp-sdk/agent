registry=https://registry.npmjs.org/
strict-ssl=false
# The build resolves the sibling workspace repos (@abc-protocol/sdk,
# @abc-protocol/bundled-extension, @abcp/agent-sdk, @abcp/agent-sdk) from the
# LOCAL working copies via file: links rather than fetching immutable git
# snapshots from GitHub. This removes the token dependency from image builds
# and means the monorepo's SDKs are always built from the current source.
@abc-protocol:registry=https://registry.npmjs.org/
