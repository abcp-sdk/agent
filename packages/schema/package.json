{
  "name": "@abcp-agent/schema",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./*": "./dist/*",
    "./gen/*": "./dist/gen/*"
  },
  "scripts": {
    "build": "tsc --emitDeclarationOnly && node ../../scripts/build-esbuild.mjs && tsx ../../scripts/gen-extension-schema.mjs",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@abc-protocol/sdk": "git+http://git.agent.svc.cluster.local/abc-protocol/abc-protocol-typescript.git#v3.11.0",
    "@abcp/agent-sdk": "git+http://git.agent.svc.cluster.local/abc-protocol/agent-sdk-typescript.git#v0.28.0",
    "@bufbuild/protobuf": "^2.14.1",
    "@connectrpc/connect": "^2.2.0",
    "neverthrow": "^8.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
