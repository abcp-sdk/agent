{
  "name": "@easylab-agent/schema",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./*": "./dist/*",
    "./gen/*": "./dist/gen/*"
  },
  "scripts": {
    "build": "tsc --emitDeclarationOnly && node ../../scripts/build-esbuild.mjs && node ../../scripts/gen-extension-schema.mjs",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.14.1",
    "@connectrpc/connect": "^2.2.0",
    "@easylab/client-sdk": "github:easylab-platform/easylab-client-sdk-ts#v0.1.1",
    "neverthrow": "^8.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
