{
  "name": "@easylab-agent/server",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc --emitDeclarationOnly && node ../../scripts/build-esbuild.mjs",
    "dev": "tsx watch src/index.ts",
