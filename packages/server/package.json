    "test": "vitest run"
  },
  "dependencies": {
    "@abc-protocol/sdk": "1.0.7",
    "@bufbuild/protobuf": "^2.14.1",
    "@connectrpc/connect": "^2.2.0",
    "@connectrpc/connect-node": "^2.2.0",
    "@easylab-agent/agent": "*",
    "@easylab-agent/schema": "*",
    "neverthrow": "^8.2.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
